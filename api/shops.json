---
layout: null
---
{%- comment -%}
  這個檔案由 Jekyll 自動產生所有店家資料，不要手動填入店家。
  新增欄位時：在下面的 fields 清單加上欄位名稱即可。
  dishes 的 name_en 包在 dishes 裡，不用另外列。
{%- endcomment -%}
{%- assign fields = "name,name_en,branch,status,address,zip,city,district,lat,lng,coords_approx,price_level,price_note,rating,tags,hours,hours_checked,dishes,photos,visited,updated,links" | split: "," -%}
[
{%- for shop in site.shops -%}
  {%- assign slug = shop.path | split: "/" | last | replace: ".md", "" -%}
  {
    "slug": {{ slug | jsonify }},
    {%- for f in fields %}
    {{ f | jsonify }}: {{ shop[f] | jsonify }},
    {%- endfor %}
    {%- comment -%} 心得用 <!-- en --> 分成中文（上）和英文（下），英文存成 body_en {%- endcomment -%}
    {%- assign parts = shop.content | split: "<!-- en -->" %}
    "body": {{ parts[0] | markdownify | strip | jsonify }},
    "body_en": {{ parts[1] | markdownify | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
